# Twelve Data API key (server-side only — never prefix with NEXT_PUBLIC_)
# Get a free key at https://twelvedata.com/pricing
TWELVE_DATA_API_KEY=

# Access gate (see README → Access). Required everywhere except `pnpm dev`, which skips
# sign-in while ACCESS_PASSWORD is empty. Server-side only — never prefix with NEXT_PUBLIC_.
# The password visitors enter: 12 to 256 characters; a long passphrase is best.
ACCESS_PASSWORD=
# Signs the session cookie: at least 32 random characters, e.g. `openssl rand -base64 32`.
AUTH_SECRET=

# Data store (see db/README.md). All optional: without them the app fetches everything live, as
# before. Server-side and scripts only — never prefix with NEXT_PUBLIC_, and never paste the values
# anywhere but .env.local and Vercel's or GitHub's secret settings.
# Owner connection, direct (not pooled) host, for `pnpm db:migrate` and `pnpm db:watchlist` only.
DATABASE_OWNER_URL=
# Passwords `pnpm db:migrate` gives the two roles it creates: 32+ letters, digits, '-' or '_'.
DATABASE_APP_PASSWORD=
DATABASE_COLLECTOR_PASSWORD=
# The app's read-only connection (role eventlens_app, pooled host).
DATABASE_URL=
# The collectors' connection (role eventlens_collector).
COLLECTOR_DATABASE_URL=
